__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
# Données de tool.coverage.run (pyproject.toml) : jamais commitées, comme le reste des
# artefacts de test. Manquait à cette liste alors que la section coverage existe déjà.
.coverage
.coverage.*
htmlcov/
# Fichiers d'état écrits dans DATA_DIR. Ils atterrissent à la RACINE quand DATA_DIR n'est
# pas défini (défaut = répertoire courant), d'où cette liste en plus de instance/.
# CONTRÔLE : tout `os.path.join(data_dir, …)` du code doit avoir sa ligne ici — c'est ce
# que vérifie test_gitignore_couvre_tous_les_fichiers_detat.
# `network.json` porte le PSK Wi-Fi EN CLAIR : son absence était le risque le plus concret
# (audit 2026-07-28 — lifetime.json traînait déjà non suivi à la racine).
data_draft.json
data_published.json
admin_secret.json
settings.json
antenna.json
journal.jsonl
lifetime.json
network.json
viewer.json
configs/
history/
instance/

# Sauvegardes et temporaires de l'écriture atomique (<chemin>.bak / <chemin>.tmp)
*.bak
*.tmp

# Version gravée au déploiement par deploy/setup-pi.sh. Artefact GÉNÉRÉ : committé, il
# se figerait à la valeur du poste qui l'a produit et mentirait sur tous les autres.
comroster/VERSION

# Outillage de test JS (dev uniquement — rien de tout ceci ne part sur le boîtier)
node_modules/

# macOS
.DS_Store
.thumbnail

# Archives de référence (itérations précédentes)
ComRoster archives/
RIEDEL SOFTS/

# Brouillons de travail des agents (briefs, rapports, paquets de revue) : du scratch,
# reconstructible depuis le plan et git log.
.superpowers/
